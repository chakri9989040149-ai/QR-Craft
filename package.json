  "description": "Ultra-sleek peer-to-peer file and document transfer via QR code or 6-digit alphanumeric code",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently \"tsx server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts"
  },
  "keywords": ["p2p", "qr-code", "file-sharing", "webrtc", "express", "react"],
